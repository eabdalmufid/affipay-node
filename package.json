{
  "name": "@affidev/affipay-node",
  "version": "1.0.1",
  "description": "SDK/client untuk integrasi payment gateway Affipay",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "affidev",
    "affipay",
    "payment-gateway",
    "payment",
    "indonesia"
  ],
  "author": {
    "name": "eabdalmufid",
    "email": "mail@affidev.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eabdalmufid/affipay-node"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "homepage": "https://github.com/eabdalmufid/affipay-node",
  "bugs": {
    "url": "https://github.com/eabdalmufid/affipay-node/issues"
  }
}
